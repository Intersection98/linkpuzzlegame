{
  "name": "line-puzzle-collection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/visual-smoke.mjs",
    "verify:levels": "vite-node scripts/verify-levels.ts && vite-node scripts/verify-slitherlink.ts && RUN_PIPELINK_VERIFY=1 vite-node scripts/verify-pipelink.ts && vite-node scripts/verify-thermometers.ts && vite-node scripts/verify-hashi.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
